{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint .",
    "format": "oxfmt \"src/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"e2e/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"next.config.ts\" \"playwright.config.ts\" \"playwright.electron.config.ts\" \"postcss.config.mjs\"",
    "format:check": "oxfmt --check \"src/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"e2e/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"next.config.ts\" \"playwright.config.ts\" \"playwright.electron.config.ts\" \"postcss.config.mjs\"",
    "test:e2e": "playwright test --config=playwright.config.ts --project=chromium",
    "test:e2e:electron": "playwright test --config=playwright.electron.config.ts --project=electron-desktop"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "posthog-js": "^1.447.15",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.2.0",
    "react-easy-crop": "^6.2.5",
    "react-hot-toast": "^2.6.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "use-intl": "^4.15.1",
    "vaul": "^1.1.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion@<1.1.21": "1.1.21",
    "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
    "minimatch": "^11.0.4",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.4",
    "undici": "^7.29.1",
    "postcss": "8.5.32",
    "postcss-selector-parser": "^7.1.3",
    "browserslist": "^4.28.7",
    "sharp": "$sharp",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.12.34"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
