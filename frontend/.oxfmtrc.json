{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [".next/", "build/", "coverage/", "node_modules/", "out/", "test-results/", "next-env.d.ts", "src/lib/i18n/messages/"]
}
