{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "alwaysStrict": true,
    "rootDir": "..",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../frontend/src/*"],
      "@countries": ["../main/countries.ts"],
      "@print/*": ["../shared/print/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["../tests/**/*", "../main/**/*", "../shared/**/*", "../frontend/src/**/*"]
}
